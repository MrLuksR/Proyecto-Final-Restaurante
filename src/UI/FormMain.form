<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="UI.FormMain">
  <grid id="27dc6" binding="vntMain" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="9a6f6" class="javax.swing.JLabel" binding="lblNombre">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Nombre del Programa"/>
        </properties>
      </component>
      <splitpane id="2ed1f" binding="splMain">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="200"/>
          </grid>
        </constraints>
        <properties>
          <dividerSize value="5"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="95bb6" binding="vntButtons" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <splitpane position="left"/>
            </constraints>
            <properties>
              <opaque value="true"/>
              <verifyInputWhenFocusTarget value="true"/>
              <visible value="true"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="58ed1" class="javax.swing.JButton" binding="btnPedidos">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Pedidos"/>
                </properties>
              </component>
              <component id="8ec60" class="javax.swing.JButton" binding="btnHistorial">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Historial"/>
                </properties>
              </component>
              <component id="2ba85" class="javax.swing.JButton" binding="btnReservas">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Reservas"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="b758e" binding="vntInfoBase" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <splitpane position="right"/>
            </constraints>
            <properties>
              <enabled value="true"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="6bfca" class="javax.swing.JLabel" binding="lblInformación">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Información del programa"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </splitpane>
    </children>
  </grid>
</form>
